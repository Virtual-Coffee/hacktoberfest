# ---------------------------------------------------------------------------
# Better Auth
# ---------------------------------------------------------------------------

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# ---------------------------------------------------------------------------
# Real GitHub sign-in (optional; maintainers only)
#
# Leave these unset and sign in with the Auth DevTools panel instead -- that
# is all most contributors need. With them set, sign-in goes through
# production's OAuth callback and back to localhost (README "Authentication"),
# so they must be PRODUCTION's values: ask a maintainer. There is no separate
# local OAuth app.
# ---------------------------------------------------------------------------

# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# OAUTH_PROXY_SECRET=

# ---------------------------------------------------------------------------
# GitHub org membership -> admin role
#
# Resolved at sign-in and stored on the user, then re-checked against GitHub
# only once the stored role is over an hour old -- so admin membership can be
# revoked without waiting for the next sign-in, but ordinary requests still do
# not call GitHub. Requires the read:org scope, which lib/auth.ts requests.
# Leave VC_GITHUB_ORG unset locally to skip the check entirely; everyone is
# then a regular user.
# ---------------------------------------------------------------------------

VC_GITHUB_ORG=Virtual-Coffee

# Optional. Comma-separated team slugs whose members also get the admin role.
# Overrides the built-in default (hacktoberfest-team). Org owners always get it.
VC_GITHUB_ADMIN_TEAMS=

# ---------------------------------------------------------------------------
# Which Hacktoberfest year the site collects submissions for.
#
# NEXT_PUBLIC_ because util/globals.ts is imported by client components. Next
# inlines it at BUILD time, so changing it needs a rebuild, not just a
# redeploy. The deployed value lives in netlify.toml under [build.environment].
#
# Defaults to the current calendar year when unset.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_HACKTOBERFEST_YEAR=2026

# ---------------------------------------------------------------------------
# Manual kill switch to pause sign ups independent of the year cutoff above --
# e.g. while site changes are in progress. Same NEXT_PUBLIC_/build-time-inline
# caveats as NEXT_PUBLIC_HACKTOBERFEST_YEAR apply.
#
# Set to "true" to pause; unset or "false" to leave sign ups open.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SIGNUPS_PAUSED=

# ---------------------------------------------------------------------------
# Auth devtools
#
# Nothing to set. `pnpm dev` shows a "Auth DevTools" panel (bottom-right) for
# creating throwaway Member/Admin users and switching between their sessions,
# so admin pages can be worked on without a Virtual Coffee org membership. It
# is off whenever NODE_ENV=production, which covers every Netlify context.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Netlify DB
#
# Nothing to set. `netlify dev` starts the local database and injects its
# connection; deployed functions get theirs from the Netlify runtime.
# ---------------------------------------------------------------------------
