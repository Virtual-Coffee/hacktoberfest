# ---------------------------------------------------------------------------
# Better Auth
# ---------------------------------------------------------------------------

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# LOCAL DEVELOPMENT ONLY. Must match the port `netlify dev` serves on and the
# callback URL registered on your GitHub OAuth app.
#
# Do NOT set this on Netlify, in any context. The site is served on more than
# one hostname and a pinned value breaks sign-in the way NEXTAUTH_URL used to;
# lib/auth.ts derives the host from the request against an allowlist instead.
BETTER_AUTH_URL=http://localhost:8888

# ---------------------------------------------------------------------------
# GitHub OAuth app
#   Settings -> Developer settings -> OAuth Apps
#   Authorization callback URL: http://localhost:8888/api/auth/callback/github
#
# Use a separate OAuth app for local development. A GitHub OAuth app allows
# exactly one callback URL, which is also why deploy previews cannot complete
# sign-in -- see the note in netlify.toml.
# ---------------------------------------------------------------------------

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# GitHub org membership -> admin role
#
# Resolved once per sign-in and stored on the user, so admin checks never call
# GitHub. Requires the read:org scope, which lib/auth.ts requests. Leave
# VC_GITHUB_ORG unset locally to skip the check entirely; everyone is then a
# regular user.
# ---------------------------------------------------------------------------

VC_GITHUB_ORG=Virtual-Coffee

# Optional. Members of this team also get the admin role. Org owners always do.
VC_GITHUB_ADMIN_TEAM=

# ---------------------------------------------------------------------------
# Which Hacktoberfest year the site collects submissions for.
#
# NEXT_PUBLIC_ because util/globals.ts is imported by client components. Next
# inlines it at BUILD time, so changing it needs a rebuild, not just a
# redeploy. The deployed value lives in netlify.toml under [build.environment].
#
# Defaults to the current calendar year when unset.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_HACKTOBERFEST_YEAR=2026

# ---------------------------------------------------------------------------
# Netlify DB
#
# Nothing to set. `netlify dev` starts the local database and injects its
# connection; deployed functions get theirs from the Netlify runtime.
# ---------------------------------------------------------------------------
